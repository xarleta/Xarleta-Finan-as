# Local configuration and signing material (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Local source snapshots kept only as recovery material
/lib_backup_*/
